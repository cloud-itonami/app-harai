#!/usr/bin/env kbb
;; smoke-worker — 実際にビルドされた bundle を import して叩く。
;;
;; ここが「deploy される成果物」に触る唯一の検査である。test/harai/route_test.cljk
;; はソースの判断を固定するが、bundle が本当に Worker の形で答えるかは言えない
;; —— export の形、shadow の :advanced-optimization、`shadow.resource/inline` で
;; 焼いた CSS は、どれもビルドを通って初めて存在する。
;;
;; Usage:  kbb --backend sci scripts/smoke-worker.cljk [<dist/worker.js>]
;; Exit:   0 全て期待どおり · 1 期待と違う · 2 判定できなかった（bundle が無い等）

(require '["node:fs" :as fs] '["node:path" :as path] '["node:url" :as url]
         '[kotoba.lang.text :as str])

(def bundle
  "ESM の import は相対パスを package 名と読むので、必ず絶対パスに直してから
  file:// URL にする（`dist/worker.js` をそのまま渡すと『Cannot find package dist』
  になる。実測）。"
  (let [a (first (remove #(str/starts-with? % "--") *command-line-args*))]
    (.resolve path (or a "dist/worker.js"))))

(def failures (atom []))
(defn check! [label expected actual]
  (let [ok (= expected actual)]
    (println (str (if ok "PASS" "FAIL") "\t" label "\texpected=" (pr-str expected) "\tactual=" (pr-str actual)))
    (when-not ok (swap! failures conj label))))

(when-not (.existsSync fs bundle)
  (println (str "UNDETERMINED\tno bundle at " bundle))
  (println "Refusing to report a pass: build it first (see docs/operator-quickstart.md §6).")
  (js/process.exit 2))

(def sentinel
  "env の VALUE がページに出ていないことを確かめるための印。実在しそうな値
  （\"yoro\" 等）だと二つの問題がある: 他の文言と偶然一致しうるし、引用符ごと
  探すと renderer が \" を &quot; に escape するので**決して一致しない** ——
  つまり検査が構造的に落ちなくなる。"
  "SENTINEL-4b71e0")

(def router-url
  "中継先は **値そのもの** がページに出る。ここを .invalid（RFC 2606 で必ず
  解決しない TLD）にしておくと、出ていることを実 DNS に依存せず確かめられる。
  中継の到達不能も同じ理由でここに寄せてある。"
  "https://mcp.example.invalid/xrpc/probe")

(def probe-method
  "APP_CAPABILITIES から読んだ値が出ていることを確かめる印。実在しない名前に
  してあるので、view が本物の 8 個を焼いていたらこの検査は落ちる。"
  "probeMethodZeta")

(def env #js {"APP_NANOID" "r3k9mwvx"
              "APP_UI_TYPE" sentinel
              "APP_CAPABILITIES" (str "[\"" probe-method "\"]")
              "AGENTGATEWAY_MCP_ROUTER_URL" router-url})

(defn- call [h method path]
  (let [req (js/Request. (str "https://harai.etzhayyim.com" path) #js {:method method})]
    (-> (js/Promise.resolve ((.-fetch h) req env #js {}))
        (.then (fn [res] (-> (.text res)
                             (.then (fn [body] {:status (.-status res)
                                                :ct (.get (.-headers res) "content-type")
                                                :body body}))))))))

(-> (js/import (.-href (.pathToFileURL url bundle)))
    (.then
     (fn [m]
       (let [h (.-default m)]
         (check! "default export has fetch" true (fn? (.-fetch h)))
         (-> (js/Promise.all
              #js [(call h "GET" "/") (call h "POST" "/xrpc/")
                   (call h "OPTIONS" "/xrpc/x") (call h "GET" "/nope")
                   (call h "GET" "/xrpc/x") (call h "GET" "/health")
                   (call h "POST" "/xrpc/a/b") (call h "POST" "/xrpc/com.x.y")])
             (.then
              (fn [[page bad pre nf wrong-method health multi single]]
                (check! "GET / status" 200 (:status page))
                (check! "GET / is html" true (str/includes? (or (:ct page) "") "text/html"))
                ;; ページは route 表から描かれる。表にある path が全部出ていること。
                (doseq [p ["/" "/xrpc/:nsid"]]
                  (check! (str "page advertises " p) true (str/includes? (:body page) p)))
                ;; env のキーは出す、値は出さない —— **ただし 2 つは意図的に出す**。
                ;; 片方だけの印だと「全部隠す」実装も「全部出す」実装も通ってしまう
                ;; ので、出ないはずの印と出るはずの値を別々に見る。
                (check! "page shows a var key" true (str/includes? (:body page) "APP_NANOID"))
                (check! "page hides other var values" false (str/includes? (:body page) sentinel))
                (check! "page shows the relay target it uses" true (str/includes? (:body page) router-url))
                ;; APP_CAPABILITIES は env から読んで描く。焼いた 8 個ではない。
                (check! "page shows the methods env declares" true
                        (str/includes? (:body page) probe-method))
                (check! "page does not bake the real capability list" false
                        (str/includes? (:body page) "closeAccount"))
                ;; **DADS の検査は 2 本に割る。** 「dads-table が在る」だけでは
                ;; 落ちない —— それは view が出力する markup であって、CSS が
                ;; 1 バイトも入っていないページにも現れる。component を呼んだか
                ;; と、stylesheet が実際に入ったかは別の主張である。
                (check! "page uses the design system components" true
                        (str/includes? (:body page) "class=\"dads-table\""))
                (check! "page carries the stylesheet itself" true
                        (str/includes? (:body page) "--color-primitive-blue"))
                ;; route の形（移行前に deploy されていた面と同じ）
                (check! "POST /xrpc/ status" 400 (:status bad))
                (check! "OPTIONS preflight" 204 (:status pre))
                (check! "unknown path" 404 (:status nf))
                (check! "wrong method on /xrpc" 405 (:status wrong-method))
                ;; /health は deploy されていた面にも無かった（quickstart §3:
                ;; grep -c health _worker.js → 0）。生やすのは移行ではない。
                (check! "/health is not served" 404 (:status health))
                ;; 多段パスは移行前の [...path] と同じく中継する。**単段と同じ
                ;; 結末になること**を、.invalid の中継先に対して見る —— 実 DNS に
                ;; 依存させないためで、いま NXDOMAIN であることに寄りかからない。
                (check! "multi-segment xrpc is not rejected" true (not= 400 (:status multi)))
                (check! "multi-segment matches single-segment" (:status single) (:status multi))
                (check! "unreachable relay is 502, not a fake 200" 502 (:status single))
                (let [f @failures]
                  (if (seq f)
                    (do (println (str "FAILED\t" (count f) " check(s): " (str/join ", " f)))
                        (js/process.exit 1))
                    (do (println "OK\tthe built bundle answers as the route table says")
                        (js/process.exit 0))))))))))
    (.catch (fn [e]
              (println (str "UNDETERMINED\tcould not exercise the bundle: " (.-message e)))
              (js/process.exit 2))))
